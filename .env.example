# ==============================================================================
# GAG Project - Consolidated Environment Configuration Reference
# ==============================================================================
# Copy the relevant blocks to the respective apps/.env files as needed.

# ------------------------------------------------------------------------------
# 1. Web App (apps/web/.env)
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="your-nextauth-secret-string"
NEXTAUTH_URL="http://localhost:3000"
EMAIL_SERVER="smtp://username:password@smtp.example.com:587"
EMAIL_FROM="noreply@example.com"

# API Integration & Service-to-service keys
API_KEY="viebrain-admin-panel-secret-key-change-in-production"
ALLOWED_ORIGINS="http://localhost:3001,http://localhost:4000,http://localhost:5000,http://localhost:5173"

# Direct links to MySQL Admin Panel Suite
NEXT_PUBLIC_ADMIN_API_URL="http://localhost:5000"
NEXT_PUBLIC_ADMIN_PANEL_URL="http://localhost:5173"


# ------------------------------------------------------------------------------
# 2. MySQL Admin Backend (apps/admin/backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
# MySQL connection string (Local or Cloud e.g., Railway / PlanetScale / Aiven)
DATABASE_URL="mysql://root:yourpassword@localhost:3306/admin_panel"
JWT_SECRET="your-long-random-jwt-secret-key"
JWT_EXPIRES_IN="7d"
AUTH_BYPASS="false"

# Allowed web origins for CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
ALLOWED_GAME_ORIGINS="http://localhost:3000"


# ------------------------------------------------------------------------------
# 3. MySQL Admin Frontend (apps/admin/frontend/.env)
# ------------------------------------------------------------------------------
VITE_PUBLIC_API_BASE="http://localhost:5000"
